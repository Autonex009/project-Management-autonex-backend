# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset to use local SQLite (autonex.db)
# PostgreSQL example: postgresql://user:pass@localhost:5432/autonex
DATABASE_URL=

# ── Supabase Storage CDN (Guidelines & Uploads) ──────────────────────────────────
# If set, guidelines uploads use Supabase Storage CDN instead of local server disk.
# Create a public bucket named 'guidelines' in Supabase Dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Change this to a long random string in production!
JWT_SECRET_KEY=autonex-super-secret-key-change-in-production

# How long a password-reset link stays valid (minutes, default 15)
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used to build the reset-password link sent in emails.
# Falls back to the Origin header, then http://localhost:5173
RESET_PASSWORD_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Brevo (free transactional email) ─────────────────────────────────────────
# Free tier: 300 emails/day — no credit card required.
# Uses Brevo's HTTP API (no extra Python packages needed).
#
# Setup:
#   1. Sign up at https://brevo.com
#   2. Go to Settings → API Keys → Generate a new API key
#   3. Go to Senders & IP → Senders → verify your sender email
#   4. Paste the API key and verified sender email below
#
BREVO_API_KEY=your-brevo-api-key-here

# Must match a verified sender in your Brevo account
MAIL_FROM=your-verified-sender@example.com
MAIL_FROM_NAME=Autonex AI

# ── Dev / Testing ─────────────────────────────────────────────────────────────
# Set to "true" to skip email sending and return the reset token directly
# in the /api/auth/forgot-password response body.
# NEVER enable this in production!
DEV_RETURN_RESET_TOKEN=false

# ── Slack integration ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=your_slack_bot_user_oauth_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# ── Salary encryption (PRODUCTION ONLY) ───────────────────────────────────────
# Encrypts employees.base_salary at rest. Set this ONLY on the production
# deployment (as a sensitive secret). Leave it UNSET in development — dev
# databases carry no real salaries, and without the key salary values are
# unreadable, which is the point.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SALARY_KEY=

# ── Hiring Portal Integration ─────────────────────────────────────────────────
# Base URL of the hiring portal backend 
# The scheduler hits this every 12 hours to import newly hired candidates
HIRING_PORTAL_BASE_URL=http://127.0.0.1:8001

# API key to authenticate with the hiring portal , if any. Leave blank if the hiring portal does not require an API key.
HIRING_PORTAL_API_KEY=

# ── Encord Integration ────────────────────────────────────────────────────────
# SSH PRIVATE key contents (single line, use \n for newlines). Register the
# matching PUBLIC key in Encord. Alternatively set ENCORD_SSH_KEY_FILE to a path.
ENCORD_SSH_KEY=
ENCORD_SSH_KEY_FILE=
# Region domain for the primary (EU/global) key. Leave blank for EU (api.encord.com).
ENCORD_DOMAIN=
# --- Second Encord region (US) ---
# Projects live in either the EU or US Encord deployment; each has its own key.
# Set these to also pull US-hosted projects. The sync tries EU first, then US, and
# uses whichever region can see each project. Leave blank if you only use EU.
ENCORD_SSH_KEY_US=
ENCORD_SSH_KEY_US_FILE=
ENCORD_DOMAIN_US=https://api.us.encord.com
# Days of history to pull on a backfill run (default 90).
ENCORD_BACKFILL_DAYS=90
# How often the background job pulls Encord analytics, in minutes (default 10).
ENCORD_SYNC_MINUTES=10
# Set to 1 to also run the legacy 12h hiring-portal sync when the scheduler is on.
ENABLE_HIRING_SYNC=



# ── Chatbot (Autonex AI assistant) ───────────────────────────────────────────
# Powers the in-app assistant and the knowledge-base search behind it. Named for the
# feature rather than the provider, so the model can change without a rename here.
# Without it the chat endpoints raise at call time; the rest of the app is unaffected.
CHATBOT_API_KEY=

# Embeddings for the chatbot policy search.
# Leave blank to disable semantic search; policy search then falls back to
# keyword matching and the rest of the chatbot is unaffected.
#
# Any OpenAI-compatible /embeddings endpoint works. Defaults are OpenAI:
#   OpenAI  EMBEDDING_BASE_URL=https://api.openai.com/v1
#           EMBEDDING_MODEL=text-embedding-3-small
#   Gemini  EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#           EMBEDDING_MODEL=text-embedding-004
# DeepSeek does NOT serve an embeddings API — a DeepSeek key will not work here.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# -- Scheduler Check-in Reminder Settings --------------------------------------
EARLY_CHECKIN_REMINDER_HOUR=8
EARLY_CHECKIN_REMINDER_MINUTE=45
CHECKIN_REMINDER_HOUR=10
CHECKIN_REMINDER_MINUTE=0
LATE_WARNING_HOUR=10
LATE_WARNING_MINUTE=45
ADMIN_REPORT_HOUR=11
ADMIN_REPORT_MINUTE=10
LATE_CHECKIN_CHANNEL_ID=C0BV91K4PD5

# -- Other Scheduler Timings --------------------------------------------------
PM_CONFIRM_REMINDER_HOUR=12
PM_CONFIRM_REMINDER_MINUTE=0
ONBOARDING_DAY5_CHECK_HOUR=10
ONBOARDING_DAY5_CHECK_MINUTE=0
ENCORD_SYNC_HOUR=23
ENCORD_SYNC_MINUTE=30
HIRING_SYNC_INTERVAL_HOURS=12
REFRESH_MATRIX_HOUR=0
REFRESH_MATRIX_MINUTE=5
CREATE_PARTITION_HOUR=2
CREATE_PARTITION_MINUTE=0

# ── Prometheus metrics ────────────────────────────────────────────────────────
# Exposes /metrics for Prometheus to scrape: request rate, latency and status
# per route, plus DB-pool and request-threadpool saturation. Always off on
# Vercel — serverless instances reset in-memory counters, so the numbers there
# describe cold starts rather than the service.
METRICS_ENABLED=true

# Shared secret Prometheus must send as "Authorization: Bearer <token>".
# Leave blank locally. SET IT IN PRODUCTION: the Railway service answers on a
# public domain, and an open /metrics publishes every route name and traffic
# pattern. Without a token the endpoint is readable by anyone.
# Matching Prometheus scrape_config:
#   authorization:
#     credentials: <token>
METRICS_TOKEN=

# The arq worker is a separate process with no HTTP server, so it serves its
# own scrape endpoint (job durations, failures, queue depth) on this port,
# behind the same METRICS_TOKEN.
WORKER_METRICS_PORT=9110

# Railway's private network is IPv6-only: set this to :: on the worker service
# so Prometheus can reach it. The IPv4 default is for local scrapes, since a
# v6 socket on Windows will not accept v4 clients.
WORKER_METRICS_HOST=0.0.0.0
